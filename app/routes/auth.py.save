@auth_bp.route("/data/confirm", methods=["POST"])
@login_required
def confirm_data():

    network = request.form.get("network")
    phone = request.form.get("phone")
    amount = float(request.form.get("amount"))

    if current_user.wallet_balance < amount:

        flash("Insufficient wallet balance")

        return redirect(
            url_for("auth.buy_data_page")
        )

    current_user.wallet_balance -= amount
  
    reward_referrer(
        current_user,
        amount
    )

    current_user.total_spent = (
        current_user.total_spent or 0.0
    ) + amount

    transaction = Transaction(
        user_id=current_user.id,
        service_type=f"{network} Data",
        amount=amount,
        recipient=phone,
        status="success",
        reference=str(uuid.uuid4())
    )

    db.session.add(transaction)
    db.session.commit()

    flash("Data purchase successful")

    return redirect(
        url_for(
            "auth.receipt",
            transaction_id=transaction.id
        )
    )


