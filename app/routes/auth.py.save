@auth_bp.route(
    "/admin/credit/<int:user_id>",
    methods=["GET", "POST"]
)
@login_required
def credit_user(user_id):

    if not current_user.is_admin:

        flash("Access denied")

        return redirect(
            url_for("auth.dashboard")
        )

    user = User.query.get_or_404(user_id)

    if request.method == "POST":

        amount = float(
            request.form.get("amount")
        )

        user.wallet_balance += amount

        user.total_funded = (
            user.total_funded or 0
        ) + amount

        db.session.commit()

        flash(
            "Wallet credited successfully"
        )

        return redirect(
            url_for("auth.admin_users")
        )

    return render_template(
        "admin/credit_user.html",
        user=user
    )

